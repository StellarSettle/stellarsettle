# Backend API used for health, event stream, and metadata requests.
VITE_BACKEND_URL=http://localhost:8787

# Default network shown by the app. Choose testnet for development.
VITE_STELLAR_NETWORK=testnet

# Legacy RPC URL for the selected default network when no network-specific URL is set.
VITE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Legacy contract ID for the selected default network when no network-specific ID is set.
VITE_STELLAR_CONTRACT_ID=

# Optional Testnet RPC override for the runtime network switcher.
VITE_STELLAR_TESTNET_RPC_URL=https://soroban-testnet.stellar.org
# Optional deployed Testnet contract ID.
VITE_STELLAR_TESTNET_CONTRACT_ID=
# Optional Mainnet RPC override for the runtime network switcher.
VITE_STELLAR_MAINNET_RPC_URL=https://mainnet.sorobanrpc.com
# Optional deployed Mainnet contract ID.
VITE_STELLAR_MAINNET_CONTRACT_ID=

# Optional deployed loan-manager contract ID. Leave empty to disable loan actions.
VITE_LOAN_MANAGER_CONTRACT_ID=
