{
  "name": "@stellarsettle/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:update": "vitest run -u",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "main entry chunk (JS)",
      "path": "dist/assets/index-*.js",
      "limit": "250 kB",
      "gzip": true
    },
    {
      "name": "all JS chunks",
      "path": "dist/assets/*.js",
      "limit": "400 kB",
      "gzip": true
    },
    {
      "name": "all CSS",
      "path": "dist/assets/*.css",
      "limit": "40 kB",
      "gzip": true
    }
  ],
  "dependencies": {
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^17.3.0",
    "i18next": "^27.1.3",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@size-limit/file": "^11.1.6",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "size-limit": "^11.1.6",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.0.5"
  }
}