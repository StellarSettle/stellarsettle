{
  "name": "@stellarsettle/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node --test --experimental-strip-types src/**/*.test.ts",
    "test:e2e": "node --test --experimental-strip-types test/*.integration.test.ts src/local-sandbox.test.ts ../e2e/backend-sandbox-event.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "node --experimental-strip-types src/migrate.ts up",
    "db:rollback": "node --experimental-strip-types src/migrate.ts down"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.4",
    "@stellar/stellar-sdk": "^17.4.0",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2"
  }
}
