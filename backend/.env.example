# Interface for the local API server.
HOST=127.0.0.1
# Port for the local API server.
PORT=8787

# Stellar network reported by the API.
STELLAR_NETWORK=testnet
# Soroban RPC endpoint used by the event monitor.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Optional contract to monitor. Leave empty to disable event polling.
STELLAR_CONTRACT_ID=

# Optional starting ledger for event recovery. Leave unset to scan the recent window.
# START_LEDGER=1

# Event-monitor polling interval in milliseconds.
POLL_INTERVAL_MS=5000
# Local SQLite database file path.
DATABASE_PATH=./data/stellarsettle.sqlite

# Optional secret required to write metadata. Keep server-side and replace before use.
METADATA_API_KEY=

# Browser origin allowed by CORS.
WEB_ORIGIN=http://localhost:5173